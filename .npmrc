# 本仓库的开发/构建配置。
#
# auto-install-peers 必须关闭:本插件的服务端入口要 import 宿主 dsh 的包,但那些包
# 刻意不写进 dependencies/peerDependencies(否则 pnpm 会去 registry 拉整套
# @deepseek-ai/*,其中包含未发布的包,安装必然 404 中断)。运行期依赖改由
# `node scripts/link-runtime-deps.mjs` 链接本机 dsh 安装提供,离线且版本与宿主一致。
confirmModulesPurge=false
auto-install-peers=false
