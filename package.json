{
  "name": "dsh-llm-agy",
  "version": "0.1.3",
  "description": "Antigravity CLI (AGY) integration for dsh: an `agy` model provider (Gemini 3.8/3.7/3.6 Flash, Gemini 3.1 Pro, Claude 4.6, GPT-OSS 120B) in the model picker, subagent delegation via subagent_agy_ui, image reading for text-only models via read_image_agy, AGY-powered Google search, account quota/usage monitoring, and a settings card with install/login status, live connectivity test and proxy configuration. Non-blocking model catalog and standard system-proxy resolution. Hot-pluggable - no dsh source changes.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "//runtime-peers": "服务端入口会 import 宿主 dsh 的包,但它们刻意只声明为 optional peer:pnpm(配合仓库 .npmrc 的 auto-install-peers=false)既不安装也不链接它们,代价为零;而 dsh 的 profile 依赖闭包投影会读取 dependencies+peerDependencies,从而知道该为自己的 node_modules 镜像投影哪些包(GitHub 安装即靠它解析)。link: 本地目录安装时父链不经过该镜像,需先跑 node scripts/link-runtime-deps.mjs。",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-util-values": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link:runtime": "node scripts/link-runtime-deps.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairyBand/dsh-llm-agy.git"
  },
  "bugs": {
    "url": "https://github.com/FairyBand/dsh-llm-agy/issues"
  },
  "homepage": "https://github.com/FairyBand/dsh-llm-agy#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "agy",
    "gemini",
    "plugin"
  ]
}
